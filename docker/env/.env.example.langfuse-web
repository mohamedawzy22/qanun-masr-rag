# Langfuse Web provides the UI and HTTP API used to manage
# traces, observations, projects, users, and configuration.

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------

NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=change-this-nextauth-secret

SALT=change-this-salt
ENCRYPTION_KEY=change-this-64-character-hex-key

TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------

DATABASE_URL=postgresql://postgres:change-this-postgres-password@postgres:5432/postgres

# ---------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------

CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-this-clickhouse-password
CLICKHOUSE_CLUSTER_ENABLED=false

# ---------------------------------------------------------
# Redis
# ---------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=change-this-redis-password

# ---------------------------------------------------------
# S3 / MinIO
# ---------------------------------------------------------

LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=change-this-minio-password
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true

LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9091
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://minio:9000

# ---------------------------------------------------------
# Optional initial project/user
# ---------------------------------------------------------

LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=